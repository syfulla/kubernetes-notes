				},
				"scale": 1
			},
			"parentId": "page:JovrcF97X_PRHRO9ZdSRz",
			"index": "aQPQ6",
			"typeName": "shape"
		},
		{
			"x": -20.833386105182853,
			"y": 16467.828337185347,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:ioA7DWTPyLRUXm37L2tRP",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1448.69140625,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The second strategy is where we do not destroy all of them at once. Instead, we take down the older version and bring up a newer version one by one. This way the application never goes down and the upgrade is seamless. Remember, if you do not specify a strategy while creating the deployment, it will assume it to be rolling update. "
								}
							]
						}
					]
				}
			},
			"parentId": "page:f68luzkeSOzKLbQERhXxs",
			"index": "b6HgaM",
			"typeName": "shape"
		},
		{
			"x": -14.4140625,
			"y": 786.4296875,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:a-Dl8FMMjZtzFaGUS3rBC",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1461.3203125,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Here is the analogy to help you visualize how containers, pods, and worker nodes work together:"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The Cargo Ship Analogy"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Imagine a global shipping operation:"
								}
							]
						},
						{
							"type": "orderedList",
							"attrs": {
								"dir": "auto",
								"start": 1,
								"type": null
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "The Container = A single cardboard box inside a shipping container."
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\tInside this box is one specific item( like an engine component). It contains exactly what is needed to function, along with it's specific instruction. In tech terms, this is your packaged application code and its dependencies"
								}
							]
						},
						{
							"type": "orderedList",
							"attrs": {
								"dir": "auto",
								"start": 2,
								"type": null
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "The Pod = A standard shipping container(Intermodal Container)."
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "You rarely ship small cardboard boxes loose; you group them into a standard shipping container."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Most shipping containers hold just one large item(single-container Pod)."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Sometimes, you put a main item and a closely related tool right next to it in the same shipping container(Multi-container/sidecar pod) They travel together, share the same space, and are dropped off at the exact same destination at the exact same time."
								}
							]
						},
						{
							"type": "orderedList",
							"attrs": {
								"dir": "auto",
								"start": 3,
								"type": null
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "The Worker Node = The Cargo Ship"
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The cargo ship is the massive physical vehicle providing the actual engine power, fuel, and deck space (CPU, RAM and Storage) to carry hundreds of shipping containers(pods). The ship doesn't care what is inside the boxes; its only job is provide the platform to keep them moving."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Summary of the Analogy"
								}
							]
						}
					]
				}
			},
			"parentId": "page:f68luzkeSOzKLbQERhXxs",
			"index": "aPtqA",
			"typeName": "shape"
