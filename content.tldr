										{
											"type": "code"
										}
									],
									"text": "Scheduler"
								},
								{
									"type": "text",
									"text": ": The Scheduler is responsible for distributing work on containers across multiple nodes it looks for newly created containers and assigns them to nodes"
								}
							]
