		{
			"x": 1146.8747202168795,
			"y": 8372.98783483738,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:h2fw9IESC4lTvdHwx3bfm",
			"type": "geo",
			"props": {
				"w": 110.43040515266784,
				"h": 56,
				"geo": "rectangle",
