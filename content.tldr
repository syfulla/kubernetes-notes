			"id": "shape:Xftkar0MTN_OWsSS3K1lV",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1434.90234375,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
