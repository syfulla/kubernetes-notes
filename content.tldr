			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1421.1953125,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Kubectl: "
								},
								{
									"type": "text",
									"text": "The command line tool or cube CTL or cube control, as it is also called the cube control tool, is used to deploy and manage applications on a Kubernetes cluster to get cluster information, to get the status of other nodes in the cluster, and to manage many other things"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "kubectl run hello-minikube: "
								},
								{
									"type": "text",
									"text": "This command is used to deploy and application on the cluster"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "kubectl cluster-info: "
								},
								{
									"type": "text",
									"text": "The cube CTL cluster info command is used to view information about the cluster"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "kubectl get nodes: "
								},
								{
									"type": "text",
									"text": "The cube CTL get nodes command is used to list all the nodes part of the cluster. "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
