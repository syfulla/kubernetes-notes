			"opacity": 1,
			"meta": {},
			"id": "shape:9SEU6mMHdrfKEGcCV_kNB",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1441.91015625,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Pods are the smallest deployable computing units that you can create and manage in Kubernetes. A Pod acts as a wrapper that hosts one or more containers( such as docker container) representing a single instance of a running process in your cluster. "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Kubernetes does not deploy containers directly on the worker nodes the containers are encapsulated into a Kubernetes object known as pods"
								}
							]
						}
					]
				}
			},
			"parentId": "page:f68luzkeSOzKLbQERhXxs",
			"index": "aO1IE",
