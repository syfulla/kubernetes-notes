							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "what are containers?."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Containers are completely isolated environments. And they have their own processes or services, their own network interfaces, their own monts, just like virtual machines, except they all share the same OS Kernel"
								}
							]
						}
					]
				}
