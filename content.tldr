		},
		{
			"x": -32.969606008716255,
			"y": 4223.077142716986,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:08FZkRRdnE6m0erx-gDbX",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1426.953125,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "What if the node on which your application is running fails? Well, obviously our application goes down, so you need to have more than one node."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Cluster: "
								},
								{
									"type": "text",
									"text": "A cluster is a set of nodes grouped together. This way even if one node fails, you have your application still accessible from the other nodes. Moreover, having multiple nodes helps in sharing load as well"
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "b1PmOA",
			"typeName": "shape"
