		},
		{
			"x": 647.8046875,
			"y": 944.0334177577473,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:2Kq7akF1d3H2krvFmey_T",
			"type": "line",
			"props": {
				"dash": "dotted",
				"size": "s",
				"color": "black",
				"spline": "line",
				"points": {
					"a1": {
