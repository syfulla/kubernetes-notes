		{
			"x": 861.5221965370529,
			"y": 18488.833490412988,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:DZciKXcqA6wi5oUEOaKmO",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 60.6171875,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
