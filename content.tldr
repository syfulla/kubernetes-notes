		},
		{
			"x": -20.65625,
			"y": 530.9453125,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:MYA7E7rw0DAa5kJy0_fMp",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1437.16015625,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Setting up Kubernetes in docker desktop is probably the easiest to get started with, and it has Kubernetes Support built in, Then we have miniKube which is a tool used to set up a single instance of Kubernetes in an all in one setup and kube admin is a tool used to configure Kubernetes in a multi node setup There are also hosted versions available for setting up Kubernetes in a cloud environment such as GCP, AWS or Azure and these are one click access so you just click on a button and it provisions an entire Kubernetes cluster for you and then you gain access to it"
								}
							]
						}
					]
				}
			},
			"parentId": "page:f68luzkeSOzKLbQERhXxs",
			"index": "aMRib",
			"typeName": "shape"
		},
		{
			"x": -56.016481008716255,
			"y": 5610.444330216986,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:dTwaA5WOc2bdReHKV-UsJ",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1444.578125,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Scheduler"
								},
								{
									"type": "text",
									"text": ": The Scheduler is responsible for distributing work on containers across multiple nodes it looks for newly created containers and assigns them to nodes"
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
