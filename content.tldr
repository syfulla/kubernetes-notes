		{
			"x": 8.799984570644597,
			"y": 11245.189053803893,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:eS0wf6i0wYxoX5w0HumnR",
			"type": "geo",
			"props": {
				"w": 728.7822982362146,
				"h": 355.90923666269555,
				"geo": "rectangle",
