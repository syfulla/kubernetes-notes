		{
			"x": 343.8246355573014,
			"y": 10525.990837438227,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:beAl442-Ia30XSc833kw-",
			"type": "geo",
			"props": {
				"w": 197.89822142373436,
				"h": 183.8357594791687,
				"geo": "rectangle",
				"dash": "draw",
				"growY": 0,
				"url": "",
				"scale": 1,
				"flipX": false,
				"flipY": false,
				"color": "black",
