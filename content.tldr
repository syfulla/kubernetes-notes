			"type": "geo",
			"props": {
				"w": 187.6180735613905,
				"h": 280.69657358425366,
				"geo": "rectangle",
				"dash": "draw",
				"growY": 0,
				"url": "",
				"scale": 1,
				"flipX": false,
				"flipY": false,
				"color": "black",
				"labelColor": "black",
				"fill": "none",
