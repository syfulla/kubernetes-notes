		{
			"x": -82.75413569794478,
			"y": 10126.578581885084,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:XDaL_xr5f6ayB5IynZz7N",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1620.6517311781524,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "features"
								}
							]
						},
						{
							"type": "orderedList",
							"attrs": {
								"dir": "auto",
								"start": 1,
								"type": null
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "crictl provides a CLI for CRI-compatible container runtimes"
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Installed separately"
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Used to inspect and debug container runtimes"
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "\t\tNot to create Containers ideally"
								}
							]
						},
						{
							"type": "orderedList",
							"attrs": {
								"dir": "auto",
								"start": 4,
								"type": null
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Works across different runtimes"
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The crictl tool is maintained and developed by Kubernetes community. The Crictl control is a command line utility that is used to interact with the CRI compatible container runtime. The ctr and nerdctl tool that were build by the container community specifically for containerd. This tool is from the Kubernetes perspective that works across different container runtimes. So it must be installed separately and it is used to inspect and debug container runtime. So this again is not ideally used to create containers. Unlike Docker or the nerdctl utility this is again a debugging tool . You can technically create containers with the crictl utility, but it's not easy and it is only to be used for some special debugging purposes. Remember that it works along with kubelet, so we know that the Kubelet is responsible for ensuring that the specific number of containers or pods are available on node at a time. So, if you go through the crictl utility and try and create containers with it, then eventually kubelet is going to delete them because the Kubelet is unaware of some of those containers or pods that are created outside of its knowledge"
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "b3Dc5U",
			"typeName": "shape"
