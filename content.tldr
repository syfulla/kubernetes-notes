		{
			"x": 662.5499252412837,
			"y": 4599.260736466986,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:OYRc72g9_NLPa8bbpVrGX",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 106.0703125,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
