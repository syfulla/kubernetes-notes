		},
		{
			"x": -68.10369491008011,
			"y": 8822.489987366567,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:4AnqmS_FCFSj0zyelzTKz",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1600.7227382750618,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Containerd is although part of Docker is a separate project on it's own now and is a member of CNCF with the graduated status. So you can now install containerd on it's own without having to install Docker itself. So, if you don't really need Docker's other features, you could ideally just install containerd alone. So, typically we ran containers using the docker run command when we had docker. If docker isn't installed then how do you run containers with just containerd. containerd comes with a command line tool called ctr. This tool is solely made for debugging containerd and is not very user friendly as it only supports a limited set of features. "
								}
							]
						},
						{
							"type": "orderedList",
							"attrs": {
								"dir": "auto",
								"start": 1,
								"type": null
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "ctr comes with containerd"
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Not very user friendly"
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Supports limited features only"
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Other these limited set of features that it provides, if you want to interact with containerd, you will have to rely on making API calls directly, which is not the most user friendly way for us to operate. "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "This ctr command can be used to perform basic container related activities such as pull images and to run containers by specifing the address. This tool is solely made for debugging containerd and is not very user friendly and not to be used for running or managing containers on a production environment"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "b2umr6",
			"typeName": "shape"
