								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Labels and selectors"
								}
							]
						}
					]
				}
			},
			"parentId": "page:f68luzkeSOzKLbQERhXxs",
			"index": "b2c9Qz",
			"typeName": "shape"
		},
		{
			"x": 20.69921875,
			"y": 11029.995052143344,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:-9pQB6PfIg2x3gBQX9l_Q",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1418.96875,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The selector is one of the major differences between replication controller and replica set. The selector is not a required field in case of a replication controller, but it is still available when you skip it. The selector section helps the replica set identify what pods fall under it, but why would you have to specify what pods fall under it if we have provided the contents of the pod defination file itself in the template, It’s because replica set can also manage pods that were not created as part of the replica set creation. Say for example, the reports created before the creation of the replica set that matched labels specified in the selector. The replica set will also take those pods into consideration when creating the replicas."
								}
							]
						}
					]
				}
			},
			"parentId": "page:f68luzkeSOzKLbQERhXxs",
			"index": "b2Zvn6",
			"typeName": "shape"
