									"text": "10.244.0.2"
								}
							]
						}
					]
				}
			},
			"parentId": "page:JovrcF97X_PRHRO9ZdSRz",
			"index": "a6SW2",
			"typeName": "shape"
		},
		{
			"x": -74.22443810466396,
			"y": 7958.223622687969,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:cWoXVAzZJr9hJjXb7rRt1",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1642.381006325537,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Docker isn't just a container runtime alone. Docker consists of multiple tools that are put together, for example the Docker CLI, the DOcker API, the build tools that help in building images. There was support for volumes of security, and also container runtime called RunC the daemon that managed RunC was called as ContainerD. So, Containerd is CRI compatible and can work directly with Kubernetes as all other runtimes. So, Containerd can be used as a runtime on its own, separate from Docker. Now you have containerd as a separate runtime and Docker separately. So, Kubernetes containued to maintain support for Docker Engine directly. However, having to maintain the Docker Shim was an unnecessary effort and added complications, so it was decided in version 1.24 release of Kubernetes to remove Dockershim completely, and so support for Docker was removed. But you see all the images that were built before Docker was removed continue to work because docker followed the image spec from the OCI standard. So, all the images built by Docker follow the standard so they continue to work with containerd. But Docker itself was removed as a supported runtime from Kubernetes."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "b2eufA",
			"typeName": "shape"
		},
		{
			"x": 19.7890625,
			"y": 646.3203125,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:6TnyEOhRvqxiozWyJtkmm",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1437.9140625,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "How is it getting this IP address when kubernetes is initially configured?. We create an internal private network with the address 10.244.0.0 and all the pods are attached to it. when you deploy multiple pods, they all get a separate IP assigned from this network. The pods can communicate to each other through this IP, but accessing the other pods using this internal IP address may not be a good idea, as it’s subject to change when pods are recreated. We will see better ways to establish communication between pods in a while. "
								}
							]
						}
					]
				}
			},
