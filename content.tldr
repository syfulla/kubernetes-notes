								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "We use spec to specify the container or image we need in the pod. Because a Pod can run multiple containers side-by-side the containers field expects a YAML list(indicated by the dash - )"
								}
							]
						}
					]
