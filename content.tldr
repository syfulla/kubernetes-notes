					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "etcd"
								},
								{
									"type": "text",
									"text": ": etcd is a distributed, reliable key value store used by kubernetes to store all data used to manage the cluster. Think of it this way when you have multiple nodes and multiple and multiple masters in your cluster, etcd stores all that information on all the nodes in the cluster in a distributed manner."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "etcd is responsible for implementing locks within the cluster to ensure that there are no conflicts between the masters"
								}
							]
						}
					]
				}
			},
